<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Enigma.HardCopy.Desktop"
             x:Class="Enigma.HardCopy.Desktop.App"
             RequestedThemeVariant="Default">

  <!-- ViewModel-first navigation: a page ViewModel bound as content is rendered by its matching view. -->
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <!-- The application's semantic palette, declared per theme variant.

       These are defined here rather than taken from the Fluent theme because the theme does not offer them:
       Avalonia 12's Fluent brushes are the SystemControl* family, which has no notion of "this message is a
       warning". The values are the WinUI semantic colours, and a message that says a recovered file is
       unverified has to stay legible in both light and dark — so both variants are given, not one plus a
       hope. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#5D5D5D" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F9F9F9" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#0F7B0F" />
          <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#DFF6DD" />
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#9D5D00" />
          <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4CE" />
          <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE7E9" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#C5C5C5" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2C" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3D3D3D" />
          <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#393D1B" />
          <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#433519" />
          <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#442726" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- The application's whole visual vocabulary. Stock Fluent controls throughout (a validated decision):
         these are type-scale, spacing and severity-colour classes over the theme's own brushes, not a
         restyling of the controls. -->

    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="24" />
      <Setter Property="Spacing" Value="16" />
      <Setter Property="MaxWidth" Value="880" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).field">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Margin" Value="0,0,12,4" />
    </Style>

    <Style Selector=":is(TextBlock).value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- A hash or a code is read character by character, so it is set in a fixed pitch with a fallback chain
         rather than a single family that only exists on one of the two target platforms. -->
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,Menlo,monospace" />
    </Style>

    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,Menlo,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.notice">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>

    <Style Selector="Border.notice.success">
      <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>

    <Style Selector="Border.notice.success > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>

    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>

    <Style Selector="Border.notice.warning > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>

    <Style Selector="Border.notice.error">
      <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>

    <Style Selector="Border.notice.error > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).success">
      <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
    </Style>

    <!-- The activity log is a list for the scrolling and the virtualization, not for the selection. -->
    <Style Selector="ListBox.log">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.log > ListBoxItem">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

  </Application.Styles>

</Application>
