<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Enigma.HardCopy.Desktop"
             x:Class="Enigma.HardCopy.Desktop.App"
             RequestedThemeVariant="Default">

  <!-- ViewModel-first navigation: a page ViewModel bound as content is rendered by its matching view. -->
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <!-- The house control library's theme: one Color per variant, one SolidColorBrush per Color, and a
       ControlTheme for every control the library ships. It has a ResourceDictionary root, so it is merged
       here as a ResourceInclude — a StyleInclude fails the build with AVLN2000.

       This replaces the nine App-local semantic brushes this file used to declare per variant
       (SubtleForeground, CardBackground/Border and the Success/Warning/Error foreground+background pairs).
       The dictionary's Enigma* keys cover every one of them, in both variants, and each brush follows a
       RequestedThemeVariant switch on its own — which is why every reference below is a DynamicResource:
       a StaticResource freezes the colour at load and the control stops following the variant.

       Order matters inside MergedDictionaries: on a duplicate key the last dictionary wins, so any
       dictionary of ours that overrides an Enigma* key has to be merged AFTER this one. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Enigma.Avalonia.Desktop/Themes/Fluent.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- The base FluentTheme stays: the library declares a ControlTheme only for its own controls plus
         TextBox and ComboBox, so dropping it would leave every other framework control — including the
         ones nested inside the library's own templates — without a template. -->
    <FluentTheme />

    <!-- The application's whole visual vocabulary: type-scale, spacing and severity-colour classes over
         the library theme's Enigma* brushes, not a restyling of the controls. TextBox and ComboBox are
         deliberately absent — the library's dictionary restyles those two by overriding FluentTheme's own
         TextControl* / ComboBox* keys, so hand-styling them here would only fight it. -->

    <Style Selector="StackPanel.page">
      <Setter Property="Margin" Value="24" />
      <Setter Property="Spacing" Value="16" />
      <Setter Property="MaxWidth" Value="880" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundSecondaryBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).field">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Margin" Value="0,0,12,4" />
    </Style>

    <Style Selector=":is(TextBlock).value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- A hash or a code is read character by character, so it is set in a fixed pitch with a fallback chain
         rather than a single family that only exists on one of the two target platforms. -->
    <Style Selector=":is(TextBlock).mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,Menlo,monospace" />
    </Style>

    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,Liberation Mono,Menlo,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource EnigmaSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Border.notice">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderSubtleBrush}" />
    </Style>

    <!-- The severity fills come as a Background/Border pair — the same pair the library's own InfoBar uses —
         so the border takes Enigma…BorderBrush while the text inside takes the accent (Enigma…Brush). -->
    <Style Selector="Border.notice.success">
      <Setter Property="Background" Value="{DynamicResource EnigmaSuccessBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaSuccessBorderBrush}" />
    </Style>

    <Style Selector="Border.notice.success > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaSuccessBrush}" />
    </Style>

    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="{DynamicResource EnigmaWarningBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaWarningBorderBrush}" />
    </Style>

    <Style Selector="Border.notice.warning > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaWarningBrush}" />
    </Style>

    <Style Selector="Border.notice.error">
      <Setter Property="Background" Value="{DynamicResource EnigmaErrorBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaErrorBorderBrush}" />
    </Style>

    <Style Selector="Border.notice.error > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaErrorBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).success">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaSuccessBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).warning">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaWarningBrush}" />
    </Style>

    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{DynamicResource EnigmaErrorBrush}" />
    </Style>

    <!-- The activity log is a list for the scrolling and the virtualization, not for the selection. -->
    <Style Selector="ListBox.log">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.log > ListBoxItem">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

  </Application.Styles>

</Application>
