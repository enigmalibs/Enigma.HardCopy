<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editors="using:Enigma.Avalonia.Desktop.Controls.Editors"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:res="using:Enigma.HardCopy.Desktop.Resources"
             xmlns:vm="using:Enigma.HardCopy.Desktop.ViewModels"
             mc:Ignorable="d"
             x:Class="Enigma.HardCopy.Desktop.Views.RecoverView"
             x:DataType="vm:RecoverViewModel"
             DragDrop.AllowDrop="True">

  <!-- No progress block and no outcome panel on this page: a run goes to the modal overlay card and its
       outcome to the window's info bar. Everything else stays exactly where it was — the completeness bar and
       the missing-index list are state a user reads while standing at a scanner, not activity, and a
       three-hundred-entry log cannot be replaced by a one-line banner. -->

  <UserControl.Styles>
    <!-- The code box's height, reached through the editor's text presenter.

         The library's BaseEditor template sizes its input area from the text and honours neither MinLines nor
         the control's own MinHeight — both were tried, and both only pad the control around an unchanged
         three-line box. This is the page's primary input: one code at the sparsest density is nine hundred
         characters, so a box that small would be scrolled through rather than read. The template part is
         Avalonia's own TextBox contract (TextBox.OnApplyTemplate requires it), which is what makes it a
         reasonable thing to reach for; should a later library version rename it, the style stops applying and
         the box goes back to its natural size — smaller, never broken. -->
    <Style Selector="editors|MultiLineTextEditor.mono /template/ TextPresenter#PART_TextPresenter">
      <Setter Property="MinHeight" Value="110" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="{x:Static res:Strings.RecoverHeader}" />
      <TextBlock Classes="body" Text="{x:Static res:Strings.RecoverIntro}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,16,1.1*">

      <!-- Feeding codes in -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="16">

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{x:Static res:Strings.RecoverImportHeader}" />
              <Button Command="{Binding ImportImagesCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{ei:IconGeometry Images}" Width="16" Height="16" />
                  <TextBlock Text="{x:Static res:Strings.RecoverImportImages}" />
                </StackPanel>
              </Button>
              <TextBlock Classes="hint" Text="{x:Static res:Strings.RecoverDropHint}" />
            </StackPanel>
          </Border>

          <!-- The code box is the library's MultiLineTextEditor: it brings the title row, the placeholder and
               the trailing action slot the plain TextBox needed three extra elements for. It derives from
               TextBox, so the mono class still reaches it — through the :is(TextBox) selector in App.axaml. -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="h2" Text="{x:Static res:Strings.RecoverManualHeader}" />
              <TextBlock Classes="hint" Text="{x:Static res:Strings.RecoverManualHint}" />
              <editors:MultiLineTextEditor Classes="mono"
                                           Title="{x:Static res:Strings.RecoverManualCodesTitle}"
                                           Text="{Binding ManualEntry}"
                                           PlaceholderText="{x:Static res:Strings.RecoverManualPlaceholder}"
                                           MinHeight="110"
                                           MaxHeight="220">
                <editors:MultiLineTextEditor.ActionContent>
                  <Button Command="{Binding AddCodesCommand}" Padding="8,4" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{ei:IconGeometry Keyboard}" Width="14" Height="14" />
                      <TextBlock Text="{x:Static res:Strings.RecoverAddCodes}" />
                    </StackPanel>
                  </Button>
                </editors:MultiLineTextEditor.ActionContent>
              </editors:MultiLineTextEditor>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="accent" Command="{Binding AssembleCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{ei:IconGeometry ShieldCheck}" Width="16" Height="16" />
                <TextBlock Text="{x:Static res:Strings.RecoverAssemble}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding SaveAnywayCommand}" IsVisible="{Binding CanSaveAnyway}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{x:Static res:AppIcons.ConfirmUnverifiedSave}" Width="16" Height="16" />
                <TextBlock Text="{x:Static res:Strings.RecoverSaveAnyway}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding StartOverCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{ei:IconGeometry Broom}" Width="16" Height="16" />
                <TextBlock Text="{x:Static res:Strings.RecoverStartOver}" />
              </StackPanel>
            </Button>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

      <!-- What is in, and what is still missing -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*">

        <Border Grid.Row="0" Classes="card" Margin="0,0,0,16">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="{x:Static res:Strings.RecoverStatusHeader}" />

            <TextBlock Classes="hint"
                       Text="{x:Static res:Strings.RecoverNothingYet}"
                       IsVisible="{Binding !HasAnyCode}" />

            <StackPanel Spacing="10" IsVisible="{Binding HasAnyCode}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="{x:Static res:Strings.RecoverBackupIdLabel}" />
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value mono" Text="{Binding BackupId}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field"
                           Text="{x:Static res:Strings.RecoverFileLabel}"
                           IsVisible="{Binding HasMetadata}" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                                     Text="{Binding FileName}"
                                     IsVisible="{Binding HasMetadata}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field"
                           Text="{x:Static res:Strings.RecoverExpectedSha256Label}"
                           IsVisible="{Binding HasMetadata}" />
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value mono"
                                     Text="{Binding ExpectedSha256}"
                                     IsVisible="{Binding HasMetadata}" />
              </Grid>

              <Border Classes="notice warning" IsVisible="{Binding !HasMetadata}">
                <TextBlock Text="{x:Static res:Strings.RecoverMetadataMissing}" TextWrapping="Wrap" />
              </Border>

              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="{x:Static res:Strings.RecoverChunksLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding CodesText}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="{x:Static res:Strings.RecoverMissingLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding MissingText}" TextWrapping="Wrap" />
              </Grid>

              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />

              <TextBlock Classes="hint"
                         Text="{x:Static res:Strings.RecoverCompleteHint}"
                         IsVisible="{Binding IsComplete}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Classes="h2" Margin="0,0,0,8" Text="{x:Static res:Strings.RecoverLogHeader}" />
            <ListBox Grid.Row="1" Classes="log" ItemsSource="{Binding Activity}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:StatusMessage">
                  <TextBlock Text="{Binding Text}"
                             TextWrapping="Wrap"
                             Classes.success="{Binding IsSuccess}"
                             Classes.warning="{Binding IsWarning}"
                             Classes.error="{Binding IsError}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

      </Grid>
    </Grid>
  </Grid>

</UserControl>
