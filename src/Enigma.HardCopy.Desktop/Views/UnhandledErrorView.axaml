<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:Enigma.HardCopy.Desktop.Resources"
             xmlns:vm="using:Enigma.HardCopy.Desktop.ViewModels"
             x:Class="Enigma.HardCopy.Desktop.Views.UnhandledErrorView"
             x:DataType="vm:UnhandledErrorViewModel"
             MinWidth="480">

  <!-- Enigma.GitClient's error view, at the same size and in the same style, so the Enigma apps fail
       alike. Its monospace family and toolbar button live in GitClient's app-wide styles; here they are
       the view's own, the only place this app uses them. -->

  <UserControl.Resources>
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, JetBrains Mono, DejaVu Sans Mono, Consolas, Menlo, monospace</FontFamily>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderBrush}" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EnigmaHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
    <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EnigmaPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EnigmaBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EnigmaForegroundBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">

    <TextBlock x:Name="LeadText"
               Text="{Binding Lead}"
               TextWrapping="Wrap"
               MaxWidth="560"
               HorizontalAlignment="Left"
               Foreground="{DynamicResource EnigmaForegroundBrush}" />

    <TextBlock x:Name="MessageText"
               Text="{Binding Message}"
               TextWrapping="Wrap"
               MaxWidth="560"
               HorizontalAlignment="Left"
               FontWeight="SemiBold"
               Foreground="{DynamicResource EnigmaForegroundBrush}" />

    <TextBlock x:Name="MoreText"
               Text="{Binding MoreText}"
               IsVisible="{Binding HasMore}"
               TextWrapping="Wrap"
               MaxWidth="560"
               HorizontalAlignment="Left"
               Foreground="{DynamicResource EnigmaForegroundSecondaryBrush}" />

    <!-- Collapsed: the details are for a bug report, not for reading. Selectable, so a part of them can
         be copied too, and bounded, so a long stack scrolls inside the dialog. -->
    <Expander x:Name="DetailsExpander"
              Header="{x:Static res:Strings.UnhandledErrorDetails}"
              IsExpanded="False"
              HorizontalAlignment="Stretch"
              AutomationProperties.Name="{x:Static res:Strings.UnhandledErrorDetailsName}">
      <StackPanel Spacing="8">
        <TextBox x:Name="DetailsText"
                 Text="{Binding Details, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 MaxHeight="220"
                 MaxWidth="560"
                 FontSize="12"
                 FontFamily="{DynamicResource MonospaceFontFamily}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static res:Strings.UnhandledErrorDetailsTextName}" />
        <Button x:Name="CopyDetailsButton"
                Classes="toolbar"
                HorizontalAlignment="Left"
                Command="{Binding CopyDetailsCommand}"
                ToolTip.Tip="{x:Static res:Strings.UnhandledErrorCopyDetailsTip}"
                AutomationProperties.Name="{x:Static res:Strings.UnhandledErrorCopyDetails}">
          <TextBlock Text="{x:Static res:Strings.UnhandledErrorCopyDetails}" />
        </Button>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
