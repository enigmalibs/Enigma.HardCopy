<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:res="using:Enigma.HardCopy.Desktop.Resources"
             xmlns:vm="using:Enigma.HardCopy.Desktop.ViewModels"
             mc:Ignorable="d"
             x:Class="Enigma.HardCopy.Desktop.Views.BackupView"
             x:DataType="vm:BackupViewModel">

  <!-- No progress block and no outcome panel on this page. A run is shown on the modal overlay card and its
       outcome on the window's info bar, both driven from the ViewModel through the application's own seams.
       What stays inline is what is not an outcome: the file's own facts, and the standing warning about a
       backup that will run to many pages. -->

  <ScrollViewer>
    <StackPanel Classes="page">

      <TextBlock Classes="h1" Text="{x:Static res:Strings.BackupHeader}" />
      <TextBlock Classes="body" Text="{x:Static res:Strings.BackupIntro}" />

      <!-- 1 · the file -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{ei:IconGeometry File}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Classes="h2" Text="{x:Static res:Strings.BackupSourceHeader}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding ChooseFileCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{ei:IconGeometry Files}" Width="16" Height="16" />
                <TextBlock Text="{x:Static res:Strings.BackupChooseFile}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="hint"
                       VerticalAlignment="Center"
                       Text="{x:Static res:Strings.BackupNoFileChosen}"
                       IsVisible="{Binding !HasFile}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto"
                IsVisible="{Binding HasFile}">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="{x:Static res:Strings.BackupFileLabel}" />
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding FileName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="{x:Static res:Strings.BackupSizeLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding SizeText}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="{x:Static res:Strings.BackupSha256Label}" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value mono" Text="{Binding Sha256Hex}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 2 · how densely to pack the codes.

           The density is the one thing on this page the user sets rather than reads, so it is the one row
           that becomes a SettingsCard: a labelled, described row with its control at the trailing end. The
           panels around it stay plain Borders — a card fires its command on PointerPressed and reads as
           something you can change, which is wrong for a hash the user is only meant to compare. -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{ei:IconGeometry Printer}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Classes="h2" Text="{x:Static res:Strings.BackupSettingsHeader}" VerticalAlignment="Center" />
          </StackPanel>

          <controls:SettingsCard Header="{x:Static res:Strings.BackupChunkSizeLabel}"
                                 Description="{x:Static res:Strings.BackupChunkSizeNote}"
                                 IconData="{ei:IconGeometry Barcode}">
            <ComboBox ItemsSource="{Binding ChunkSizes}"
                      SelectedItem="{Binding SelectedChunkSize}"
                      MinWidth="300">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChunkSizeOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:SettingsCard>

          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasFile}">
            <TextBlock Classes="field" Text="{x:Static res:Strings.BackupEstimateLabel}" />
            <TextBlock Classes="value" Text="{Binding EstimateText}" />
          </StackPanel>

          <Border Classes="notice warning" IsVisible="{Binding HasLargeInputWarning}">
            <TextBlock Text="{Binding LargeInputWarning}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <!-- 3 · where the PDF goes -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{ei:IconGeometry FloppyDisk}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Classes="h2" Text="{x:Static res:Strings.BackupOutputHeader}" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding ChooseOutputCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{ei:IconGeometry Files}" Width="16" Height="16" />
                <TextBlock Text="{x:Static res:Strings.BackupChooseOutput}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="hint"
                       VerticalAlignment="Center"
                       Text="{x:Static res:Strings.BackupNoOutputChosen}"
                       IsVisible="{Binding !HasOutput}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasOutput}">
            <TextBlock Grid.Column="0" Classes="field" Text="{x:Static res:Strings.BackupOutputLabel}" />
            <SelectableTextBlock Grid.Column="1" Classes="value" Text="{Binding OutputLocation}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Generate.

           The two icons here deliberately take the two different routes into the Phosphor pack, so that a
           build and a launch prove both: {ei:IconGeometry} resolves the path data at XAML load time, while
           AppIcons resolves it in C# through PhosphorIconSet.Instance.GetGlyph(...).ToGeometry(). Neither
           carries a brush — a PathIcon inherits its Foreground from the button, so both follow a
           theme-variant switch.

           Cancel stays on the page as well as on the overlay card: the card is what a user sees during a run,
           but this button is where the keyboard focus already is. -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Classes="accent" Command="{Binding GenerateCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{ei:IconGeometry FilePdf}" Width="16" Height="16" />
            <TextBlock Text="{x:Static res:Strings.BackupGenerate}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{x:Static res:AppIcons.Cancel}" Width="16" Height="16" />
            <TextBlock Text="{x:Static res:Strings.BackupCancel}" />
          </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
