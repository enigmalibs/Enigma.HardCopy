<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Enigma.Avalonia.Desktop.Controls"
             xmlns:ei="https://github.com/josueclement/Enigma.Icons"
             xmlns:res="using:Enigma.HardCopy.Desktop.Resources"
             xmlns:vm="using:Enigma.HardCopy.Desktop.ViewModels"
             mc:Ignorable="d"
             x:Class="Enigma.HardCopy.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!-- The one page of this application built the way the library's settings cards are meant to be used: a
       stack of labelled rows, each an icon, a header, a description and its control — no surrounding
       Border.card, because here the card IS the row. There is one preference, and the intro says why; the
       about row below it is not a preference, only the way to the About dialog. -->

  <ScrollViewer>
    <StackPanel Classes="page">

      <TextBlock Classes="h1" Text="{x:Static res:Strings.SettingsHeader}" />
      <TextBlock Classes="body" Text="{x:Static res:Strings.SettingsIntro}" />

      <!-- Three choices, not a light/dark toggle: "follow the system" has to stay reachable, and a toggle
           only offers it until the first click. The choice applies the moment it is made — there is no
           Apply button and nothing to confirm, because looking at the result IS the confirmation. -->
      <controls:SettingsCard Header="{x:Static res:Strings.SettingsThemeLabel}"
                             Description="{x:Static res:Strings.SettingsThemeNote}"
                             IconData="{ei:IconGeometry Palette}">
        <ComboBox ItemsSource="{Binding Themes}"
                  SelectedItem="{Binding SelectedTheme}"
                  MinWidth="220">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ThemeOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </controls:SettingsCard>

      <!-- The About dialog every Enigma app shares (icon, name, version, build, copyright) opens from here: the
           rail holds the pages, and this application has no menu to put it on. -->
      <controls:SettingsCard Header="{x:Static res:Strings.SettingsAboutLabel}"
                             Description="{Binding AboutNote}"
                             IconData="{ei:IconGeometry Info}">
        <Button Name="OpenAbout"
                Command="{Binding OpenAboutCommand}"
                Content="{x:Static res:Strings.SettingsAboutButton}"
                AutomationProperties.Name="{x:Static res:Strings.SettingsAboutButton}" />
      </controls:SettingsCard>

    </StackPanel>
  </ScrollViewer>

</UserControl>
