<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Shown before Avalonia draws its first frame: Enigma.Avalonia.Desktop's EnigmaBackgroundColor (Light), so
       the launch does not flash a different colour. -->
  <color name="window_background">#FFF7F8FA</color>
  <!-- The launcher icon's background layer, behind its QR code. The desktop icon (packaging/icon/enigma-hardcopy.svg)
       has no tile and lets the desktop show through; an adaptive icon's background must be opaque, so here the
       branding's tile colour fills the shape the launcher masks it to. -->
  <color name="app_icon_background">#FF1E1F22</color>
</resources>
