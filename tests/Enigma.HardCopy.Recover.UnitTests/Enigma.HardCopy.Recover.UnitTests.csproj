<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single net10.0 target of the shared project under test. The Android head is not referenced:
         it needs a device, and everything worth asserting without one lives in the shared project. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.HardCopy.Recover/Enigma.HardCopy.Recover.csproj" />
  </ItemGroup>
</Project>
