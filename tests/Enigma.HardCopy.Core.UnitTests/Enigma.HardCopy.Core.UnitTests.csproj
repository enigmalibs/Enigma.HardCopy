<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the single net10.0 target of the library under test. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <!-- SkiaSharp's Linux native assets: the library pulls SkiaSharp in through the ZXing binding but,
         as a library, ships no native runtime of its own. The test host needs them to decode images
         (exercised from PHASE04 onward). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Enigma.HardCopy.Core/Enigma.HardCopy.Core.csproj" />
  </ItemGroup>
  <!-- Fixture copy-glob: raw binary and text fixtures the suite loads by relative path
       (round-trip fixtures arrive in PHASE02/PHASE04). -->
  <ItemGroup>
    <None Update="**/*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
