<Project>

  <!-- Central Package Management: every PackageReference version in the solution is pinned
       here so shared dependencies (e.g. Avalonia, SkiaSharp) cannot drift between projects.
       Projects reference packages WITHOUT a Version attribute (<PackageReference Include="Foo" />);
       the version comes from the matching <PackageVersion> below. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Core library. Targets net10.0 only, so the netstandard2.0-support pair
       (System.Buffers / PolySharp) is deliberately absent. -->
  <ItemGroup>
    <PackageVersion Include="QuestPDF" Version="2026.7.2" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="ZXing.Net.Bindings.SkiaSharp" Version="0.16.22" />
    <!-- SkiaSharp is pinned to the version Avalonia 12.1.1 itself depends on, NOT the newest
         release (4.151.0): the ZXing SkiaSharp binding and Avalonia.Skia must resolve to one
         Skia runtime. Bump this only together with the Avalonia ecosystem group below. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <!-- Hosting / logging — shared by the Desktop app (and a future CLI). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

  <!-- Desktop (Avalonia) — this is a version-coupled ecosystem: bump Avalonia, the Fluent theme,
       the Inter fonts and the diagnostics support TOGETHER, never one package at a time. Mixing
       versions within the set breaks the build, so the whole group moves as a unit (SkiaSharp
       above is part of that unit — see its note). -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <!-- The Android head of the recovery app (src/Enigma.HardCopy.Recover.Android). Same set, same rule:
         it moves with Avalonia and never on its own. -->
    <PackageVersion Include="Avalonia.Android" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The house control library and its icon packs. Enigma.Avalonia.Desktop pins Avalonia 12.1.1,
         Avalonia.Themes.Fluent 12.1.1 and CommunityToolkit.Mvvm 8.4.2 — exactly the versions above —
         so it belongs to this same version-coupled group and moves with it. Enigma.Icons.Avalonia
         needs Avalonia >= 12.1.0 and is coupled for the same reason.
         Enigma.Icons and Enigma.Icons.Phosphor arrive transitively through Enigma.Icons.Avalonia;
         they are listed here to pin the versions rather than inherit them, exactly as
         Avalonia.Themes.Fluent and CommunityToolkit.Mvvm are. Enigma.Core (and its
         BouncyCastle.Cryptography dependency) also arrives transitively with the control library:
         nothing in this app calls it, it backs the library's binary editors, and there is no way
         to opt out short of not referencing the library. -->
    <PackageVersion Include="Enigma.Avalonia.Desktop" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons.Phosphor" Version="1.0.0" />
    <PackageVersion Include="Enigma.Icons.Avalonia" Version="1.0.0" />
  </ItemGroup>

  <!-- Android camera (src/Enigma.HardCopy.Recover.Android only): the CameraX bindings. One release line —
       camera-camera2 pins camera-core to its own patch range, so the three move together. CameraX is the
       AndroidX camera library Google recommends over raw Camera2; its frames are decoded in-process by ZXing
       through Core, so no barcode SDK and no Play Services are involved.
       1.6.1, not the newer 1.6.1.1 / 1.6.2: those move AndroidX Lifecycle to 2.11, while Avalonia.Android 12.1.1
       pins its Lifecycle packages to the 2.10 line (NU1608). Bump CameraX together with the Avalonia group, once
       Avalonia's AndroidX set has moved. -->

  <ItemGroup>
    <PackageVersion Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1" />
    <PackageVersion Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1" />
  </ItemGroup>

  <!-- Tests (MTP-native: xunit.v3 only; coverlet.collector for coverage). No Microsoft.NET.Test.Sdk. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
