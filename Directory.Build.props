<Project>

  <!-- Shared settings for every project in the solution. Package versions are
       centralized separately in Directory.Packages.props (Central Package Management). -->
  <PropertyGroup>
    <!-- Fill these in for the solution (author/copyright metadata). -->
    <Authors>Josué Clément</Authors>
    <Copyright>Copyright © 2026 Josué Clément</Copyright>
    <!-- Solution-wide release version: the library, the app and its Windows file-version resource all
         carry the same number, so a printed PDF can always be traced back to the build that made it.
         The app.manifest's assemblyIdentity version is maintained alongside it (Windows requires the
         4-part form there). Bump both together. -->
    <Version>1.1.0</Version>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Explicit usings everywhere: every file declares its own using directives. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Warnings are treated as errors across the whole solution (library, CLI, Desktop, tests). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Enforce the .editorconfig code-style rules (the warning-level subset) at build time. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
